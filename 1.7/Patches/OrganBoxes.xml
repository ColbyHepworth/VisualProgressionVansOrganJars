<?xml version="1.0" encoding="utf-8"?>
<!-- Organs' normal art is the base game's box, or a retexture of it, so organs no one made never show Van's jars. -->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Heart"]/graphicData</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Heart"]/graphicData</xpath>
      <value>
        <graphicData Class="VisualProgression.GraphicData_FromMod">
          <texPath>Things/Item/Health/HealthItem</texPath>
          <skipMods>
            <li>sirvan.organretexture</li>
          </skipMods>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>0.80</drawSize>
          <color>(190,190,190)</color>
        </graphicData>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Heart"]</xpath>
      <value>
        <graphicData Class="VisualProgression.GraphicData_FromMod">
          <texPath>Things/Item/Health/HealthItem</texPath>
          <skipMods>
            <li>sirvan.organretexture</li>
          </skipMods>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>0.80</drawSize>
          <color>(190,190,190)</color>
        </graphicData>
      </value>
    </nomatch>
  </Operation>

