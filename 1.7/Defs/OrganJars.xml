<?xml version="1.0" encoding="utf-8"?>
<!-- Natural organs are Van's jars up to the medieval age and the base game's organ box from the industrial age on. -->
<Defs>

  <!-- Heart -->
  <ThingStyleDef>
    <defName>VPOJ_Heart_Jar</defName>
    <graphicData Class="VisualProgression.GraphicData_FromMod">
      <texPath>Things/Item/BodyPart_Heart</texPath>
      <fromMod>sirvan.organretexture</fromMod>
      <drawSize>1</drawSize>
    </graphicData>
  </ThingStyleDef>

  <VisualProgression.ItemLooksDef>
    <defName>VPOJ_Heart</defName>
    <item>Heart</item>
    <looks>
      <li><upToAge>Medieval</upToAge><style>VPOJ_Heart_Jar</style></li>
    </looks>
  </VisualProgression.ItemLooksDef>

